SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

APP_NAME=turn-api
APP_ENV=local
APP_LEGACY_API_ENABLED=false
APP_SUBSCRIPTION_LIFECYCLE_DELAY_MS=300000
APP_SUBSCRIPTION_ENFORCEMENT_ENABLED=true
APP_GUEST_ANONYMIZATION_CRON=0 30 3 * * *

DB_CONNECTION_IP=localhost
DB_CONNECTION_PORT=5432
DB_NAME=turn
DB_USERNAME=postgres
DB_PASSWORD=password

APP_JPA_DDL_AUTO=validate
APP_JPA_SHOW_SQL=false
APP_JPA_FORMAT_SQL=true

APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_ACCESS_TOKEN_MINUTES=15
APP_REFRESH_TOKEN_DAYS=14
APP_REFRESH_REUSE_GRACE_SECONDS=10
APP_SECURE_COOKIES=false
APP_ALLOWED_ORIGINS=http://localhost:5275,http://127.0.0.1:5275
APP_TRUST_PROXY_HEADERS=false
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_GLOBAL_PER_MINUTE=300
APP_RATE_LIMIT_AUTH_PER_MINUTE=10
APP_RATE_LIMIT_PAYMENT_PER_MINUTE=30
APP_RATE_LIMIT_PUBLIC_QUEUE_PER_MINUTE=60
APP_RATE_LIMIT_STORE=memory

APP_LIVE_QUEUE_RESET_ENABLED=true
APP_LIVE_QUEUE_RESET_DELAY_MS=30000
APP_LIVE_QUEUE_RESET_INITIAL_DELAY_MS=15000
APP_PENDING_ACCOUNTS_BUSINESS_DAILY=500
APP_PENDING_ACCOUNTS_ADMINISTRATOR_DAILY=100
APP_PENDING_ACCOUNTS_ADMINISTRATOR_PER_MINUTE=20

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
REDIS_CONNECT_TIMEOUT=2s
REDIS_COMMAND_TIMEOUT=2s

MANAGEMENT_SERVER_PORT=9090
MANAGEMENT_SERVER_ADDRESS=127.0.0.1

DB_SSL_MODE=disable
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash

APP_PAYMENT_MODE=test
APP_PAYMENT_PROVIDER=abb
APP_PAYMENT_CALLBACK_BASE_URL=http://127.0.0.1:5275

BIRBANK_API_BASE_URL=https://txpgtst.kapitalbank.az/api
BIRBANK_USERNAME=replace-with-bank-username
BIRBANK_PASSWORD=replace-with-bank-password
ABB_API_BASE_URL=https://api-test-c2b.abb-bank.az
ABB_USERNAME=replace-with-abb-test-username
ABB_PASSWORD=replace-with-abb-test-password
ABB_DEBIT_ACCOUNT=replace-with-abb-test-payer-iban
ABB_RECIPIENT_NAME=replace-with-test-recipient-name
ABB_RECIPIENT_ACCOUNT=replace-with-abb-test-recipient-iban
ABB_RECIPIENT_TAX_ID=replace-with-test-recipient-tax-id
ABB_RECIPIENT_BANK_CODE=805250
APP_PAYMENT_RECONCILIATION_ENABLED=true
APP_PAYMENT_RECONCILIATION_DELAY_MS=60000
APP_PAYMENT_RECONCILIATION_INITIAL_DELAY_MS=30000
